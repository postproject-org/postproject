{
    "id": "org.postproject.FlatpakCheck",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.10",
    "sdk": "org.kde.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "postproject-cpp-smoke",
    "modules": [
        "@MODULE@",
        {
            "name": "installed-package-consumers",
            "buildsystem": "simple",
            "build-commands": [
                "cmake -S tests/abi -B build -DCMAKE_PREFIX_PATH=\"$FLATPAK_DEST\"",
                "cmake --build build",
                "ctest --test-dir build --output-on-failure",
                "install -D build/postproject-cpp-smoke \"$FLATPAK_DEST/bin/postproject-cpp-smoke\""
            ],
            "sources": [
                "@ARCHIVE_SOURCE@"
            ]
        }
    ]
}
