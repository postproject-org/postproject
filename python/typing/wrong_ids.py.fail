"""Must fail an installed-package type check for all nine annotated calls."""

from postproject import ActivityRef, AssetId, AssetRef, Production, RepresentationId, Transaction


def wrong_kinds(production: Production, transaction: Transaction, asset: AssetId, representation: RepresentationId) -> None:
    production.asset(representation)
    production.representation(asset)
    AssetRef(representation)
    production.edit(asset)
    transaction.remove_media_root(asset)
    transaction.retire_locator(asset)
    production.job(asset)
    transaction.cancel_job(representation)
    ActivityRef(asset)
