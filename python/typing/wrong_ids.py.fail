"""Must fail an installed-package type check for all fifteen annotated calls."""

from postproject import (
    ActivityRef, ActivitySpec, RepresentationKind, AssetId, AssetRef, ClientId, DecisionBase, Production,
    ProtocolBase, RepresentationId, RequestId, Edit,
)


def wrong_kinds(production: Production, transaction: Edit, asset: AssetId, representation: RepresentationId) -> None:
    production.asset(representation)
    production.representation(asset)
    AssetRef(representation)
    production.edit(asset)
    transaction.remove_media_root(asset)
    transaction.retire_locator(asset)
    production.job(asset)
    transaction.cancel_job(representation)
    ActivityRef(asset)

    transaction.register_outputs(((representation, RepresentationKind.DERIVED, "render.mov"),), ActivitySpec("example:render"))
    ActivitySpec("example:render", inputs=(asset,))
    AssetRef(transaction.register_outputs(((asset, RepresentationKind.DERIVED, "render.mov"),), ActivitySpec("example:render")).activity_id)


def wrong_exchange(transaction: Edit, client: ClientId,
    request: RequestId, decision: DecisionBase) -> None:
    transaction.prepare_proposal(request, request)
    transaction.prepare_proposal(client, client)
    ProtocolBase(decision, client)
